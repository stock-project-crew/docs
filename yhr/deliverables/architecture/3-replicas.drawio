<mxfile host="drawio"><diagram name="3-replicas" id="3-replicas"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="복제본 2대의 런타임 — 리더 없이 같은 작업을 함께 돈다" style="rounded=0;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=20;strokeColor=none;fillColor=none;fontColor=#1A1D24;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="두 파드가 모든 주기 작업을 똑같이 돈다. 누가 할지 정하지 않고(리더 선출 · 분산 잠금 없음), 같은 일을 두 번 해도 결과가 하나가 되게 DB 조건으로 막는다" style="rounded=0;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=none;fillColor=none;fontColor=#6B7280;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c4" value="파드 A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#DCE6F8;fontColor=#3B5BDB;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="260" height="494" as="geometry"/></mxCell><mxCell id="c5" value="파드 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#DCE6F8;fontColor=#3B5BDB;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="260" height="494" as="geometry"/></mxCell><mxCell id="c6" value="PostgreSQL — 중복을 막는 조건" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#FFFFFF;fontColor=#3B5BDB;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" pare