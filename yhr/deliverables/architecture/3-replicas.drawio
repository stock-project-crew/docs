etry"/></mxCell><mxCell id="c23" value="영수증 확인 · 5분" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#FFFFFF;fontColor=#1A1D24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="326" width="220" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;영수증 확인&lt;/b&gt;&lt;br&gt;잠그지 않는다. 같은 티켓을 두 번 물어도 기록이 같다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=11;strokeColor=#C9CED8;fillColor=#F4F6FA;fontColor=#1A1D24;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="326" width="700" height="50" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Apple SD Gothic Neo;fontSize=11;strokeColor=#3B5BDB;fontColor=#1A1D24;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Apple SD Gothic Neo;fontSize=11;strokeColor=#3B5BDB;fontColor=#1A1D24;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="보유 스냅샷 생성 · 1분" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#FFFFFF;fontColor=#1A1D24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="388" width="220" height="50" as="geometry"/></mxCell><mxCell id="c28" value="보유 스냅샷 생성 · 1분" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#FFFFFF;fontColor=#1A1D24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="388" width="220" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;보유 스냅샷 생성&lt;/b&gt;&lt;br&gt;처리 기록 UNIQUE(실행 id) · (계좌, 날짜) + 날짜 advisory 잠금(공유/배타) → 계좌 FOR UPDATE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=11;strokeColor=#C9CED8;fillColor=#F4F6FA;fontColor=#1A1D24;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="388" width="700" height="50" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Apple SD Gothic Neo;fontSize=11;strokeColor=#3B5BDB;fontColor=#1A1D24;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Apple SD Gothic Neo;fontSize=11;strokeColor=#3B5BDB;fontColor=#1A1D24;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="끝난 세션 정리 · 1시간" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#FFFFFF;fontColor=#1A1D24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="220" height="50" as="geometry"/></mxCell><mxCell id="c33" value="끝난 세션 정리 · 1시간" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Apple SD Gothic Neo;fontSize=12;strokeColor=#3B5BDB;fillColor=#FFFFFF;fontColor=#1A1D24;align=center;verticalAlign=middle;spacing=8