digraph erd {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.1, pad=0.4, bgcolor="white",
         fontname="Apple SD Gothic Neo", fontsize=20, labelloc=t, labeljust=l,
         label=<<B>ERD — 포트폴리오</B>  <FONT POINT-SIZE="11" COLOR="#8A93A0">PK 기본키 · FK 다른 표를 가리킴 · UQ 유일 · null 비워 둘 수 있음 · 실선 FK · 점선 FK 없이 값으로만 가리킴</FONT>>];
  node [shape=plain, fontname="Apple SD Gothic Neo", fontsize=10];
  edge [color="#6B7280", fontname="Apple SD Gothic Neo", fontsize=9, fontcolor="#8A93A0", arrowsize=0.8];
  "account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>account</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_id</FONT></TD><TD ALIGN="LEFT" PORT="account_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_ref_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#2E7D52"><B>UQ</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_ref</FONT></TD><TD ALIGN="LEFT" PORT="account_ref_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="broker_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">broker</FONT></TD><TD ALIGN="LEFT" PORT="broker_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="label_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">label</FONT></TD><TD ALIGN="LEFT" PORT="label_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_type_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_type</FONT></TD><TD ALIGN="LEFT" PORT="account_type_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">source</FONT></TD><TD ALIGN="LEFT" PORT="source_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="credential_ref_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">credential_ref</FONT></TD><TD ALIGN="LEFT" PORT="credential_ref_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="link_state_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">link_state</FONT></TD><TD ALIGN="LEFT" PORT="link_state_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_synced_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">last_synced_at</FONT></TD><TD ALIGN="LEFT" PORT="last_synced_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="linked_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">linked_at</FONT></TD><TD ALIGN="LEFT" PORT="linked_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kis_env_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">kis_env</FONT></TD><TD ALIGN="LEFT" PORT="kis_env_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_number_masked_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_number_masked</FONT></TD><TD ALIGN="LEFT" PORT="account_number_masked_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR></TABLE>>];
  "position_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>position_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">as_of</FONT></TD><TD ALIGN="LEFT" PORT="as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_id</FONT></TD><TD ALIGN="LEFT" PORT="account_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_id</FONT></TD><TD ALIGN="LEFT" PORT="instrument_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cost_amount_local_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">cost_amount_local</FONT></TD><TD ALIGN="LEFT" PORT="cost_amount_local_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="market_value_local_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">market_value_local</FONT></TD><TD ALIGN="LEFT" PORT="market_value_local_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cost_amount_krw_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">cost_amount_krw</FONT></TD><TD ALIGN="LEFT" PORT="cost_amount_krw_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="market_value_krw_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">market_value_krw</FONT></TD><TD ALIGN="LEFT" PORT="market_value_krw_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fx_rate_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">fx_rate</FONT></TD><TD ALIGN="LEFT" PORT="fx_rate_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(18,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fx_as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">fx_as_of</FONT></TD><TD ALIGN="LEFT" PORT="fx_as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">source_as_of</FONT></TD><TD ALIGN="LEFT" PORT="source_as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_carried_forward_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">is_carried_forward</FONT></TD><TD ALIGN="LEFT" PORT="is_carried_forward_r"><FONT FACE="Menlo" COLOR="#8A93A0">bool</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_final_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">is_final</FONT></TD><TD ALIGN="LEFT" PORT="is_final_r"><FONT FACE="Menlo" COLOR="#8A93A0">bool</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">price_as_of</FONT></TD><TD ALIGN="LEFT" PORT="price_as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR></TABLE>>];
  "position_build" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>position_build</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="build_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">build_id</FONT></TD><TD ALIGN="LEFT" PORT="build_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="run_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT> <FONT COLOR="#2E7D52"><B>UQ</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">run_id</FONT></TD><TD ALIGN="LEFT" PORT="run_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_id</FONT></TD><TD ALIGN="LEFT" PORT="account_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">as_of</FONT></TD><TD ALIGN="LEFT" PORT="as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="outcome_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">outcome</FONT></TD><TD ALIGN="LEFT" PORT="outcome_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reason_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">reason</FONT></TD><TD ALIGN="LEFT" PORT="reason_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attempts_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">attempts</FONT></TD><TD ALIGN="LEFT" PORT="attempts_r"><FONT FACE="Menlo" COLOR="#8A93A0">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="built_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">built_at</FONT></TD><TD ALIGN="LEFT" PORT="built_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT FACE="Menlo" COLOR="#2E7D52" POINT-SIZE="9">UQ (account_id, as_of) WHERE (run_id IS NULL)</FONT></TD></TR></TABLE>>];
  "snapshot_run" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>snapshot_run</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">as_of</FONT></TD><TD ALIGN="LEFT" PORT="as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="finished_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">finished_at</FONT></TD><TD ALIGN="LEFT" PORT="finished_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR></TABLE>>];
  "position_basis" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>position_basis</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_id</FONT></TD><TD ALIGN="LEFT" PORT="account_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_id</FONT></TD><TD ALIGN="LEFT" PORT="instrument_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evaluated_as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">evaluated_as_of</FONT></TD><TD ALIGN="LEFT" PORT="evaluated_as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evaluated_qty_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">evaluated_qty</FONT></TD><TD ALIGN="LEFT" PORT="evaluated_qty_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="avg_cost_local_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">avg_cost_local</FONT></TD><TD ALIGN="LEFT" PORT="avg_cost_local_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,4)</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="avg_cost_krw_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">avg_cost_krw</FONT></TD><TD ALIGN="LEFT" PORT="avg_cost_krw_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,4)</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="coverage_start_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">coverage_start_at</FONT></TD><TD ALIGN="LEFT" PORT="coverage_start_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="opening_qty_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">opening_qty</FONT></TD><TD ALIGN="LEFT" PORT="opening_qty_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seed_avg_price_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">seed_avg_price</FONT></TD><TD ALIGN="LEFT" PORT="seed_avg_price_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,4)</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grade_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">grade</FONT></TD><TD ALIGN="LEFT" PORT="grade_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seed_permanent_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">seed_permanent</FONT></TD><TD ALIGN="LEFT" PORT="seed_permanent_r"><FONT FACE="Menlo" COLOR="#8A93A0">bool</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ca_unknown_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">ca_unknown</FONT></TD><TD ALIGN="LEFT" PORT="ca_unknown_r"><FONT FACE="Menlo" COLOR="#8A93A0">bool</FONT></TD></TR></TABLE>>];
  "basis_build" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>basis_build</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_id</FONT></TD><TD ALIGN="LEFT" PORT="account_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">as_of</FONT></TD><TD ALIGN="LEFT" PORT="as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="outcome_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">outcome</FONT></TD><TD ALIGN="LEFT" PORT="outcome_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reason_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">reason</FONT></TD><TD ALIGN="LEFT" PORT="reason_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="built_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">built_at</FONT></TD><TD ALIGN="LEFT" PORT="built_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR></TABLE>>];
  "realized_pnl_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>realized_pnl_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trade_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">trade_id</FONT></TD><TD ALIGN="LEFT" PORT="trade_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">account_id</FONT></TD><TD ALIGN="LEFT" PORT="account_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_id</FONT></TD><TD ALIGN="LEFT" PORT="instrument_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sold_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">sold_at</FONT></TD><TD ALIGN="LEFT" PORT="sold_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sell_amount_local_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">sell_amount_local</FONT></TD><TD ALIGN="LEFT" PORT="sell_amount_local_r"><FONT FACE="Menlo" COLOR="#8A93A0">numeric(20,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cost_basis_local_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><