digraph erd {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.1, pad=0.4, bgcolor="white",
         fontname="Apple SD Gothic Neo", fontsize=20, labelloc=t, labeljust=l,
         label=<<B>ERD — 알림</B>  <FONT POINT-SIZE="11" COLOR="#8A93A0">PK 기본키 · FK 다른 표를 가리킴 · UQ 유일 · null 비워 둘 수 있음 · 실선 FK · 점선 FK 없이 값으로만 가리킴</FONT>>];
  node [shape=plain, fontname="Apple SD Gothic Neo", fontsize=10];
  edge [color="#6B7280", fontname="Apple SD Gothic Neo", fontsize=9, fontcolor="#8A93A0", arrowsize=0.8];
  "alert" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>alert</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">alert_id</FONT></TD><TD ALIGN="LEFT" PORT="alert_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_id</FONT></TD><TD ALIGN="LEFT" PORT="instrument_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">name</FONT></TD><TD ALIGN="LEFT" PORT="name_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cadence_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">cadence</FONT></TD><TD ALIGN="LEFT" PORT="cadence_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notify_mode_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">notify_mode</FONT></TD><TD ALIGN="LEFT" PORT="notify_mode_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cooldown_min_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">cooldown_min</FONT></TD><TD ALIGN="LEFT" PORT="cooldown_min_r"><FONT FACE="Menlo" COLOR="#8A93A0">int</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">expires_at</FONT></TD><TD ALIGN="LEFT" PORT="expires_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">status</FONT></TD><TD ALIGN="LEFT" PORT="status_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trigger_type_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">trigger_type</FONT></TD><TD ALIGN="LEFT" PORT="trigger_type_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trigger_spec_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">trigger_spec</FONT></TD><TD ALIGN="LEFT" PORT="trigger_spec_r"><FONT FACE="Menlo" COLOR="#8A93A0">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="spec_version_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">spec_version</FONT></TD><TD ALIGN="LEFT" PORT="spec_version_r"><FONT FACE="Menlo" COLOR="#8A93A0">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">updated_at</FONT></TD><TD ALIGN="LEFT" PORT="updated_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">deleted_at</FONT></TD><TD ALIGN="LEFT" PORT="deleted_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_name_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_name</FONT></TD><TD ALIGN="LEFT" PORT="instrument_name_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_symbol_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_symbol</FONT></TD><TD ALIGN="LEFT" PORT="instrument_symbol_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR></TABLE>>];
  "alert_state" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>alert_state</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">alert_id</FONT></TD><TD ALIGN="LEFT" PORT="alert_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_result_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">last_result</FONT></TD><TD ALIGN="LEFT" PORT="last_result_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_known_result_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">last_known_result</FONT></TD><TD ALIGN="LEFT" PORT="last_known_result_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unknown_reason_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">unknown_reason</FONT></TD><TD ALIGN="LEFT" PORT="unknown_reason_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evaluated_as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">evaluated_as_of</FONT></TD><TD ALIGN="LEFT" PORT="evaluated_as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="spec_hash_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">spec_hash</FONT></TD><TD ALIGN="LEFT" PORT="spec_hash_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">version</FONT></TD><TD ALIGN="LEFT" PORT="version_r"><FONT FACE="Menlo" COLOR="#8A93A0">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="held_since_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">held_since</FONT></TD><TD ALIGN="LEFT" PORT="held_since_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR></TABLE>>];
  "alert_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>alert_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">event_id</FONT></TD><TD ALIGN="LEFT" PORT="event_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">alert_id</FONT></TD><TD ALIGN="LEFT" PORT="alert_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="as_of_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">as_of</FONT></TD><TD ALIGN="LEFT" PORT="as_of_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fired_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">fired_at</FONT></TD><TD ALIGN="LEFT" PORT="fired_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">title</FONT></TD><TD ALIGN="LEFT" PORT="title_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="body_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">body</FONT></TD><TD ALIGN="LEFT" PORT="body_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lines_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">lines</FONT></TD><TD ALIGN="LEFT" PORT="lines_r"><FONT FACE="Menlo" COLOR="#8A93A0">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observed_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">observed</FONT></TD><TD ALIGN="LEFT" PORT="observed_r"><FONT FACE="Menlo" COLOR="#8A93A0">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="read_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">read_at</FONT></TD><TD ALIGN="LEFT" PORT="read_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cadence_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">cadence</FONT></TD><TD ALIGN="LEFT" PORT="cadence_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT FACE="Menlo" COLOR="#2E7D52" POINT-SIZE="9">UQ (alert_id, as_of)</FONT></TD></TR></TABLE>>];
  "alert_delivery" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>alert_delivery</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">event_id</FONT></TD><TD ALIGN="LEFT" PORT="event_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="device_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">device_id</FONT></TD><TD ALIGN="LEFT" PORT="device_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="state_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">state</FONT></TD><TD ALIGN="LEFT" PORT="state_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attempts_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">attempts</FONT></TD><TD ALIGN="LEFT" PORT="attempts_r"><FONT FACE="Menlo" COLOR="#8A93A0">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="next_attempt_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">next_attempt_at</FONT></TD><TD ALIGN="LEFT" PORT="next_attempt_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expo_ticket_id_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">expo_ticket_id</FONT></TD><TD ALIGN="LEFT" PORT="expo_ticket_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sent_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">sent_at</FONT></TD><TD ALIGN="LEFT" PORT="sent_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_error_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">last_error</FONT></TD><TD ALIGN="LEFT" PORT="last_error_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR></TABLE>>];
  "push_device" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>push_device</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="device_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">device_id</FONT></TD><TD ALIGN="LEFT" PORT="device_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expo_push_token_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#2E7D52"><B>UQ</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">expo_push_token</FONT></TD><TD ALIGN="LEFT" PORT="expo_push_token_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="platform_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">platform</FONT></TD><TD ALIGN="LEFT" PORT="platform_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_seen_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">last_seen_at</FONT></TD><TD ALIGN="LEFT" PORT="last_seen_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">session_id</FONT></TD><TD ALIGN="LEFT" PORT="session_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR></TABLE>>];
  "alert_watchlist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>alert_watchlist</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="instrument_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT> <FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">instrument_id</FONT></TD><TD ALIGN="LEFT" PORT="instrument_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="market_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">market</FONT></TD><TD ALIGN="LEFT" PORT="market_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="intraday_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">intraday</FONT></TD><TD ALIGN="LEFT" PORT="intraday_r"><FONT FACE="Menlo" COLOR="#8A93A0">bool</FONT></TD></TR></TABLE>>];
  "app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" COLOR="#AAB2C0" BGCOLOR="#ECEEF1"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">app_user</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">다른 그림</FONT></TD></TR></TABLE>>];
  "auth_session" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" COLOR="#AAB2C0" BGCOLOR="#ECEEF1"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">auth_session</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">다른 그림</FONT></TD></TR></TABLE>>];
  "data.instrument" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLPADDING="6" COLOR="#C7B98F" BGCOLOR="#FDF3D6"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">data.instrument</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">데이터팀 표</FONT></TD></TR></TABLE>>];
  "alert" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "alert_state" -> "alert" [dir=both, arrowtail=tee, arrowhead=tee label="alert_id"];
  "alert_event" -> "alert" [dir=both, arrowtail=crow, arrowhead=tee label="alert_id"];
  "push_device" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "alert_delivery" -> "alert_event" [dir=both, arrowtail=crow, arrowhead=tee label="event_id"];
  "alert_delivery" -> "push_device" [dir=both, arrowtail=crow, arrowhead=tee label="device_id\n삭제 시 함께 삭제"];
  "push_device" -> "auth_session" [dir=both, arrowtail=crow, arrowhead=tee label="session_id\n삭제 시 함께 삭제"];
  "alert" -> "data.instrument" [style=dashed, dir=both, arrowtail=crow, arrowhead=none, color="#C7B98F", label="instrument_id"];
  "alert_watchlist" -> "data.instrument" [style=dashed, dir=both, arrowtail=crow, arrowhead=none, color="#C7B98F", label="instrument_id"];
}
