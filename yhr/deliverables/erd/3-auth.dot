digraph erd {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.1, pad=0.4, bgcolor="white",
         fontname="Apple SD Gothic Neo", fontsize=20, labelloc=t, labeljust=l,
         label=<<B>ERD — 로그인</B>  <FONT POINT-SIZE="11" COLOR="#8A93A0">PK 기본키 · FK 다른 표를 가리킴 · UQ 유일 · null 비워 둘 수 있음 · 실선 FK · 점선 FK 없이 값으로만 가리킴</FONT>>];
  node [shape=plain, fontname="Apple SD Gothic Neo", fontsize=10];
  edge [color="#6B7280", fontname="Apple SD Gothic Neo", fontsize=9, fontcolor="#8A93A0", arrowsize=0.8];
  "app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">id</FONT></TD><TD ALIGN="LEFT" PORT="id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#2E7D52"><B>UQ</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">email</FONT></TD><TD ALIGN="LEFT" PORT="email_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">password_hash</FONT></TD><TD ALIGN="LEFT" PORT="password_hash_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="display_name_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">display_name</FONT></TD><TD ALIGN="LEFT" PORT="display_name_r"><FONT FACE="Menlo" COLOR="#8A93A0">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR></TABLE>>];
  "auth_session" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#AAB2C0"><TR><TD COLSPAN="3" BGCOLOR="#3B5BDB" ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Menlo" COLOR="#FFFFFF" POINT-SIZE="13"><B>auth_session</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#B7791F"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">session_id</FONT></TD><TD ALIGN="LEFT" PORT="session_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#1F6FE5"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_r"><FONT FACE="Menlo" COLOR="#8A93A0">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refresh_hash_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#2E7D52"><B>UQ</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">refresh_hash</FONT></TD><TD ALIGN="LEFT" PORT="refresh_hash_r"><FONT FACE="Menlo" COLOR="#8A93A0">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prev_refresh_hash_l"><FONT FACE="Menlo" POINT-SIZE="9"><FONT COLOR="#2E7D52"><B>UQ</B></FONT></FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">prev_refresh_hash</FONT></TD><TD ALIGN="LEFT" PORT="prev_refresh_hash_r"><FONT FACE="Menlo" COLOR="#8A93A0">bytea</FONT> <FONT COLOR="#8A93A0">null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="generation_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">generation</FONT></TD><TD ALIGN="LEFT" PORT="generation_r"><FONT FACE="Menlo" COLOR="#8A93A0">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="confirmed_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">confirmed</FONT></TD><TD ALIGN="LEFT" PORT="confirmed_r"><FONT FACE="Menlo" COLOR="#8A93A0">bool</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_refreshed_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">last_refreshed_at</FONT></TD><TD ALIGN="LEFT" PORT="last_refreshed_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="absolute_expires_at_l"><FONT FACE="Menlo" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT"><FONT FACE="Menlo">absolute_expires_at</FONT></TD><TD ALIGN="LEFT" PORT="absolute_expires_at_r"><FONT FACE="Menlo" COLOR="#8A93A0">timestamptz</FONT></TD></TR></TABLE>>];
  "account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" COLOR="#AAB2C0" BGCOLOR="#ECEEF1"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">account</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">다른 그림</FONT></TD></TR></TABLE>>];
  "alert" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" COLOR="#AAB2C0" BGCOLOR="#ECEEF1"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">alert</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">다른 그림</FONT></TD></TR></TABLE>>];
  "push_device" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" COLOR="#AAB2C0" BGCOLOR="#ECEEF1"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">push_device</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">다른 그림</FONT></TD></TR></TABLE>>];
  "sync_run" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" COLOR="#AAB2C0" BGCOLOR="#ECEEF1"><TR><TD><FONT FACE="Menlo" COLOR="#3A4048">sync_run</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#8A93A0">다른 그림</FONT></TD></TR></TABLE>>];
  "account" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "alert" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "push_device" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "sync_run" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "auth_session" -> "app_user" [dir=both, arrowtail=crow, arrowhead=tee label="user_id"];
  "push_device" -> "auth_session" [dir=both, arrowtail=crow, arrowhead=tee label="session_id\n삭제 시 함께 삭제"];
}
