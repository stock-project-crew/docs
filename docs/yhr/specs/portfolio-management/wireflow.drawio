<mxCell id="p169" value="" style="whiteSpace=wrap;html=1;fillColor=#3B5BDB;strokeColor=none;strokeWidth=1;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2060" y="221" width="4" height="14" as="geometry"/></mxCell>
<mxCell id="p170" value="인증정보 비저장" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A1D24;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2072" y="214" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="p171" value="CODEF는 Connected ID만 보관하고 인증서·비밀번호는 서버에 남기지 않는다. KIS는 본인 앱키를 암호화 저장한다." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#6B7280;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2072" y="234" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="p172" value="" style="whiteSpace=wrap;html=1;fillColor=#3B5BDB;strokeColor=none;strokeWidth=1;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2060" y="297" width="4" height="14" as="geometry"/></mxCell>
<mxCell id="p173" value="항상 비동기" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A1D24;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2072" y="290" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="p174" value="동기화는 무겁고 느리다. 202로 즉시 응답하고 완료는 푸시·폴링으로 알린다." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#6B7280;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2072" y="310" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="p175" value="" style="whiteSpace=wrap;html=1;fillColor=#3B5BDB;strokeColor=none;strokeWidth=1;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2060" y="355" width="4" height="14" as="geometry"/></mxCell>
<mxCell id="p176" value="부분 실패 허용" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A1D24;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2072" y="348" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="p177" value="계좌별로 독립 재시도한다. CODEF는 지수 백오프, KIS는 레이트리밋 스로틀 중심." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#6B7280;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2072" y="368" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="p178" value="" style="whiteSpace=wrap;html=1;fillColor=#3B5BDB;strokeColor=none;strokeWidth=1;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2060" y="413" width="4" height="14" as="geometry"/></mxCell>
<mxCell id="p179" value="캐리포워드" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A1D24;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2072" y="406" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="p180" value="실패해도 그날 position_line을 반드시 만든다. 빠뜨리면 그레인 유일성이 깨지고 자산 변화 뷰의 항등식이 성립하지 않는다." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#6B7280;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2072" y="426" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="p181" value="" style="whiteSpace=wrap;html=1;fillColor=#3B5BDB;strokeColor=none;strokeWidth=1;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2060" y="489" width="4" height="14" as="geometry"/></mxCell>
<mxCell id="p182" value="as-of 두 층" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A1D24;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2072" y="482" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="p183" value="화면 as-of는 배치 실행 기준시각으로 단일. 계좌별 실제 시각은 source_as_of로 따로 추적." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#6B7280;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2072" y="502" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="p184" value="" style="whiteSpace=wrap;html=1;fillColor=#3B5BDB;strokeColor=none;strokeWidth=1;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="2060" y="565" width="4" height="14" as="geometry"/></mxCell>
<mxCell id="p185" value="총자산에서 빼지 않는다" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A1D24;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2072" y="558" width="408" height="20" as="geometry"/></mxCell>
<mxCell id="p186" value="실패 계좌를 제외하면 자산이 급감해 더 큰 오해를 낳는다. 포함하되 낡았다고 말한다. 연동 해제만 제외하되 자산 변화 뷰에 별도 항목으로 뽑는다." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#6B7280;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=1;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2072" y="578" width="400" height="54" as="geometry"/></mxCell>
